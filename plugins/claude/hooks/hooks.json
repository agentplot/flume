{
  "description": "flume's agent hooks: the started and received acks, the asking mark, the guard on submitting and pushing, the stop check and the settle once the agent is quiet, the last words a failed turn leaves, and the session's end; and the one hooks module, flume.ts, which pins the place's line under the prompt and, where the agent's profile offers deliver, runs flume hook deliver at the session's start, each turn's end and every ten seconds while no turn runs, and submits what it prints as the person's words. In a session flume did not start each does nothing but SessionStart, which runs flume inbox as the session the terminal names, confirming on receipt each end it is handed, and gives the agent each end and each place waiting on that session with its key and the ways on, or nothing. Each hook exits 0 and holds up no start.",
  "modules": ["./flume.ts"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "session-start"],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "user-prompt-submit"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "pre-tool-use"],
            "timeout": 20
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "permission-request"],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "post-tool-use"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "stop"],
            "timeout": 60
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "stop-failure"],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "flume",
            "args": ["hook", "session-end"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
