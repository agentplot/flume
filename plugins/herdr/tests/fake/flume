#!/bin/sh
# shellcheck disable=SC2016 # jq programs.
# A stand-in flume: logs each call; status answers the test's status.json,
# or, while the test drives a place ($FAKE/drive), the place at the step
# its settles have moved it to: each settle moves it one step on, from its
# launch to its landing and its tidy.
printf '%s\n' "$*" >>"$FAKE/flume-calls"
case $1 in
launch)
  echo launched >"$FAKE/drive"
  echo '{"launched":{}}'
  ;;
settle)
  if [ -f "$FAKE/drive" ]; then
    at=$(cat "$FAKE/drive")
    next=$(printf '%s\n' launched code-working code-delivered submitted landed tidied | awk -v at="$at" 'found { print; exit } $0 == at { found = 1 }')
    [ -n "$next" ] && echo "$next" >"$FAKE/drive"
  fi
  echo '{"settled":{"places":[],"tidy":{}}}'
  ;;
status)
  if [ -f "$FAKE/drive" ]; then
    jq -n --arg at "$(cat "$FAKE/drive")" --arg sock "${HERDR_SOCKET_PATH:-}" '
      {status: {host: {watch: {bound: {seconds: 30}}, bases: []},
        places: (if $at == "tidied" then [] else [{
          place: "/r/places/fix--one", kind: "fix", name: "one",
          phase: (if $at == "landed" then {over: {over: "landed"}} else "live" end),
          current: "code",
          clues: (if $at == "landed" then null else
            {stage: "code", state: ($at | sub("^code-"; "")), title: "code · x",
             display_agent: "fix--one", shown_at: {agent: "herdr:p1@\($sock)"}} end),
          submission: (if $at == "submitted" then {read: {found: {}}}
            elif $at == "landed" then {read: {found: {}}, verdict: {landed: {}}} else null end)
        }] end)}}'
  else
    cat "$FAKE/status.json" 2>/dev/null || echo '{"status":{"host":{},"places":[]}}'
  fi
  ;;
*) echo '{"acted":{}}' ;;
esac
