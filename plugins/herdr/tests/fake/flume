#!/bin/sh
# A stand-in flume: logs each call; status answers the test's
# status.json; settle shows, as flume's herdr profile does at a settle
# that changes a place's clues, each pane's title, agent and row the test
# wrote in shows, one tab-separated line each, through herdr's
# report-metadata (139, C.5).
printf '%s\n' "$*" >>"$FAKE/flume-calls"
case $1 in
status)
  cat "$FAKE/status.json" 2>/dev/null || echo '{"status":{"host":{},"places":[]}}'
  ;;
settle)
  if [ -f "$FAKE/shows" ]; then
    tab=$(printf '\t')
    while IFS=$tab read -r pane title agent row; do
      "${HERDR_BIN_PATH:-herdr}" pane report-metadata "$pane" --source flume --title "$title" \
        --display-agent "$agent" --token "flume=$row" >/dev/null
    done <"$FAKE/shows"
  fi
  echo '{"settled":{"places":[],"tidy":{}}}'
  ;;
*) echo '{"acted":{}}' ;;
esac
